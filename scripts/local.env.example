# Copy to scripts/local.env and fill in. Used by android_sync.sh, android_emu.sh, android_pixel.sh, sign_apk.sh.
ARK_BUILD_HOST="user@build-machine"        # Linux machine with JDK 21 in ~/estudely-android/jdk, Gradle in
                                           # ~/estudely-android/gradle and the SDK in ~/Android/Sdk
ARK_SSH_KEY="$HOME/.ssh/id_ed25519"
ARK_PIXEL_HOST="user@phone-host"           # optional: machine a test phone is plugged into (adb)
ARK_PIXEL_SERIAL="ADB_SERIAL"
